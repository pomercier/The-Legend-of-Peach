      "enforced_by": "audit_legend_of_peach_output()"
    },
    {
      "name": "3D Mario Trio Intro Buffers",
      "pc_range": "0x100000..0x10FFFF",
      "banks": "$20..$21",
      "owner": "mario_intro.rs",
      "enforced_by": "audit_legend_of_peach_output()"
    },
    {
      "name": "Custom 65c816 Assembly & Engine Tables",
      "pc_range": "0x110000..0x117FFF",
      "banks": "$22",
      "owner": "mario_intro.rs ($22:8000..$22:81FF) + mario_engine.rs ($22:9000..$22:99FF)",
      "enforced_by": "EXPANDED_FREE_START = 0x118000"
    },
    {
      "name": "Relocated LC_LZ2 Graphics Sheets",
      "pc_range": "0x118000..0x1D7FFF",
      "banks": "$23..$3A",
      "owner": "mixer.rs + mario_ui.rs + mario_world.rs + mario_bosses.rs",
      "enforced_by": "EXPANDED_FREE_END = OW_MAP32_RELOC_START_PC (0x1D8000)"
    },
    {
